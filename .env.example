# ==============================================================================
# OpenSource Catalog — Variáveis de Ambiente (Modelo)
# Copie este arquivo para `.env` e ajuste os valores conforme seu ambiente.
# ==============================================================================

# Aplicação Web
APP_TITLE="OpenSource Catalog"
HTTP_PORT=8080

# Pipeline de Construção e Coleta de Métricas
CATALOG_CACHE_DIR="/tmp/catalog_cache"
# Opcional: token GitHub para aumentar limite de requisições na atualização de métricas
GITHUB_TOKEN=""

# Agente E2E de Demonstração — Uptime Kuma (demos/uptime-kuma)
KUMA_DEMO_URL="https://demo.kuma.pet/start-demo"
KUMA_ADMIN_USER="kuma-admin"
KUMA_ADMIN_PASS="ALTERE_SUA_SENHA_AQUI"
PLAYWRIGHT_HEADED="false"
PLAYWRIGHT_HOLD_SECONDS="120"
